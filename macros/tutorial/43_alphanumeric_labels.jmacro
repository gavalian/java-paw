// Alphanumeric labels
// Source: ../../tut.pdf, PDF page 105 (viewer page, not printed footer).
// Adaptation: Twig custom tick labels replace HBOOK alphanumeric bins and SORT; category content moves with its label.
paw.cd("alphanumeric_labels");paw.zones(1,3);TutorialTable t=paw.staff();String[] labels={"AG","DD","DG","EF","EP","FI","LEP","PE","PS","SPS","ST","TH","TIS"};H1F base=t.project("base","Division",13,.5,13.5);
for(int mode=0;mode<3;mode++){paw.zone(mode+1);List<Integer> indices=new ArrayList<>();for(int i=0;i<13;i++)indices.add(i);if(mode==1)indices.sort(Comparator.comparing(i->labels[i]));if(mode==2)indices.sort(Comparator.<Integer>comparingDouble(base::getBinContent).reversed());H1F h=paw.h1("sorted"+mode,mode==0?"Original labels":mode==1?"Alphabetical labels":"Descending population",13,.5,13.5);String[] names=new String[13];for(int i=0;i<13;i++){h.setBinContent(i,base.getBinContent(indices.get(i)));names[i]=labels[indices.get(i)];}paw.plot(h,"B",false);paw.configure(r->r.setAxisTicksX(paw.array(13,1,13),names));}
