// Updating plots in real time (2)
// Source: ../../tut.pdf, PDF page 133 (viewer page, not printed footer).
// Adaptation: Seeded Gaussian batches; pathological zero denominators are excluded; output updates on the Swing event thread.
paw.cd("live_gaussian");paw.zones(1,3);int batches=paw.integerArgument(0,50);if(batches<1||batches>1000)throw new IllegalArgumentException("Batches 1..1000");H1F x=paw.h1("x","Gaussian x",100,-5,5),y=paw.h1("y","Gaussian y",100,-5,5),ratio=paw.h1("ratio","(x-y)/(x+y)",100,-10,10);
for(int batch=0;batch<batches;batch++){paw.check();for(int i=0;i<1000;i++){double a=paw.random.nextGaussian(),b=paw.random.nextGaussian();x.fill(a);y.fill(b);if(abs(a+b)>1e-12)ratio.fill((a-b)/(a+b));}paw.zone(1);paw.plot(x);paw.zone(2);paw.plot(y);paw.zone(3);paw.plot(ratio);paw.pause(30);}
