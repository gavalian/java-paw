// Option Spider in NTUPLE/SCAN
// Source: ../../tut.pdf, PDF page 97 (viewer page, not printed footer).
// Adaptation: Normalized multidimensional event spiders plus population average and labelled axes; synthetic staff data.
paw.cd("spider_scan");paw.zones(2,3);TutorialTable t=paw.staff();String[] vars={"Category","Age","Service","Children","Grade","Step","Cost"};double[][] columns=new double[vars.length][];double[] min=new double[vars.length],max=new double[vars.length];for(int j=0;j<vars.length;j++){columns[j]=t.column(vars[j]);min[j]=Arrays.stream(columns[j]).min().orElse(0);max[j]=Arrays.stream(columns[j]).max().orElse(1);}
for(int row=0;row<6;row++){paw.zone(row+1);double[] x=new double[vars.length+1],y=new double[x.length],ax=new double[x.length],ay=new double[x.length];for(int j=0;j<=vars.length;j++){int k=j%vars.length;double angle=2*PI*k/vars.length,radius=(columns[k][row]-min[k])/(max[k]-min[k]);double mean=Arrays.stream(columns[k]).average().orElse(0);double avg=(mean-min[k])/(max[k]-min[k]);x[j]=radius*cos(angle);y[j]=radius*sin(angle);ax[j]=avg*cos(angle);ay[j]=avg*sin(angle);}GraphErrors g=paw.graph("event"+row,x,y);g.attr().setLineColor(2);paw.plot(g,"LP",false);GraphErrors avg=paw.graph("average"+row,ax,ay);avg.attr().setLineColor(4);paw.plot(avg,"L",true);paw.configure(r->{r.axisLimitsX(-1.2,1.2);r.axisLimitsY(-1.2,1.2);});for(int j=0;j<vars.length;j++){double angle=2*PI*j/vars.length;paw.widget(new Line(0,0,cos(angle),sin(angle)),false);paw.widget(new PaveText(vars[j],cos(angle),sin(angle)).setNDF(false).setDrawBox(false),false);}}
